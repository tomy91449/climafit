<?xml version="1.0" encoding="UTF-8"?>
<!--
    pom.xml = la "ficha" del proyecto para Maven.
    Maven es la herramienta que descarga las librerías que usa el proyecto, compila el código,
    corre los tests y arma el archivo .jar que después se ejecuta (en Docker, con "java -jar").
    Este archivo le dice a Maven: qué es este proyecto, con qué versión de Java se compila,
    de qué librerías depende y cómo se empaqueta.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- Versión del formato de este archivo. Es siempre 4.0.0; no se toca. -->
    <modelVersion>4.0.0</modelVersion>

    <!--
        PADRE: el proyecto "hereda" la configuración de Spring Boot 3.5.16.
        Gracias a esto casi ninguna librería de abajo necesita versión: Spring Boot ya sabe qué
        versiones funcionan bien juntas. relativePath vacío = buscar el padre en internet
        (Maven Central), no en una carpeta del disco.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <!--
        IDENTIDAD del proyecto ("coordenadas" de Maven): grupo + nombre + versión.
        Con esto Maven genera el archivo api-gateway-1.0.0.jar, que es el que copia el Dockerfile.
    -->
    <groupId>ar.edu.utn.frc.climafit</groupId>
    <artifactId>api-gateway</artifactId>
    <version>1.0.0</version>
    <name>api-gateway</name>
    <description>Punto de entrada único: enrutamiento y Security Filter (JWT + roles)</description>

    <!-- VARIABLES: valores que se usan más abajo como ${nombre}. -->
    <properties>
        <!-- Versión de Java con la que se compila el gateway. -->
        <java.version>21</java.version>
        <!-- Versión del conjunto "Spring Cloud" (de ahí sale Spring Cloud Gateway). Es la que va con Spring Boot 3.5. -->
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <!-- Versión de springdoc, la librería que arma la página de Swagger. -->
        <springdoc.version>2.8.17</springdoc.version>
    </properties>

    <!--
        CATÁLOGO DE VERSIONES de Spring Cloud. Esto NO agrega ninguna librería al proyecto:
        solo importa la "lista de precios" que dice qué versión va de cada pieza de Spring Cloud.
        Por eso, más abajo, spring-cloud-starter-gateway-server-webflux no lleva <version>.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- DEPENDENCIAS: las librerías que el gateway usa. Maven las descarga solo. -->
    <dependencies>
        <!--
            1) climafit-commons: la librería común de ClimaFit, la misma que usan los 4 microservicios.
            El gateway usa de ella:
              - Roles: los nombres ADMIN, PROFESOR, ALUMNO y SERVICIO;
              - KeycloakRolesConverter: lee los roles que vienen dentro del token de Keycloak;
              - ErrorResponse y CodigosError: el formato JSON de los errores.
            Así el gateway interpreta los tokens y responde los errores igual que los microservicios.

            ¿Por qué la <exclusion>? La librería trae "spring-boot-starter-web" (Spring MVC + Tomcat),
            que es el servidor "clásico" que usan los microservicios. El gateway usa otro servidor,
            reactivo (WebFlux + Netty), y Spring Cloud Gateway NO arranca si encuentra Spring MVC.
            Por eso le decimos a Maven: "traé la librería, pero sin esa parte".
            Las partes de la librería pensadas para el servidor clásico (seguridad, errores, trazabilidad)
            no se activan solas en el gateway; la del cliente HTTP se apaga en application.yml.

            Para que Maven la encuentre, primero hay que instalarla en la computadora:
            en IntelliJ, panel Maven -> climafit-commons -> Lifecycle -> install.
            (En Docker lo hace solo el Dockerfile del gateway.)
        -->
        <dependency>
            <groupId>ar.edu.utn.frc.climafit</groupId>
            <artifactId>climafit-commons</artifactId>
            <version>1.0.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-web</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!--
            2) Spring Cloud Gateway: el MOTOR del gateway. Lee las rutas de application.yml
            (por ejemplo /api/clases/** -> ms-clases) y reenvía cada pedido al microservicio que
            corresponde. Trae el servidor reactivo (WebFlux + Netty).
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>

        <!--
            3) OAuth2 Resource Server: permite VALIDAR los tokens JWT que entrega Keycloak.
            Revisa la firma (con las claves públicas de Keycloak), que no estén vencidos y quién los
            emitió. Si el token falta o es inválido, el gateway responde 401.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!--
            4) Actuator: agrega la dirección /actuator/health, que responde si el gateway está vivo.
            Docker la consulta cada 10 segundos (healthcheck) para saber si el contenedor está "healthy".
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            5) Swagger UI unificado: la página http://localhost:8080/swagger-ui.html, donde se ve y se
            prueba la API de los 4 microservicios. Es la versión "webflux" porque el gateway es reactivo.
            Lleva versión porque Spring Boot no la administra.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!--
            6) Librerías SOLO para los tests (scope "test"): JUnit, Mockito y herramientas para simular
            tokens. No van dentro del .jar final; solo se usan al correr los tests.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!--
        CÓMO SE EMPAQUETA: el plugin de Spring Boot arma un .jar "ejecutable" que trae adentro
        todas las librerías. Por eso alcanza con "java -jar app.jar" para arrancarlo (ver Dockerfile).
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
