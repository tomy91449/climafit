# =====================================================================================
# Configuración de ClimaFit para Docker.
# Copiar este archivo como .env (cp .env.example .env) y completar TELEGRAM_BOT_TOKEN.
# Los valores por defecto sirven para desarrollo y demo. NUNCA subir el .env al repo.
#
# Para principiantes: docker-compose.yml lee este archivo y reemplaza cada ${NOMBRE} por el
# valor que está acá. Así las contraseñas no quedan escritas en el código.
# Formato: NOMBRE=valor (sin espacios alrededor del =). Las líneas con # son comentarios.
# =====================================================================================

# Zona horaria de todos los contenedores (las clases se guardan en hora de Córdoba).
TZ=America/Argentina/Cordoba

# PostgreSQL: superusuario del contenedor
POSTGRES_PASSWORD=postgres

# Una base y un usuario por microservicio (y uno para Keycloak)
ACTIVIDADES_DB_PASSWORD=actividades
CLASES_DB_PASSWORD=clases
NOTIFICACIONES_DB_PASSWORD=notificaciones
KEYCLOAK_DB_PASSWORD=keycloak

# Consola de administración de Keycloak (http://localhost:8090)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Secreto del cliente confidencial climafit-servicios (token de servicio entre microservicios)
CLIENTE_SERVICIOS_SECRET=cambiar-este-secreto

# Perfiles de Spring dentro de Docker: "docker" (direcciones de la red interna) y "demo" (simulación del clima)
SPRING_PROFILES_ACTIVE=docker,demo

# Avisos por Telegram: "bot" (envío real, el de la demo) o "log" (solo escribe el mensaje en el log).
# Ver "Avisos por Telegram" en el README.
TELEGRAM_PROVEEDOR=bot
# Token del bot, lo entrega @BotFather. OBLIGATORIO con "bot": si queda vacío, ms-notificaciones no arranca.
# Es un secreto: va solo en el .env, nunca en el repo. Pedíselo a quien administra el bot del grupo.
TELEGRAM_BOT_TOKEN=
